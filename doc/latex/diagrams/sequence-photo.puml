@startuml sequence-photo

title Диаграмма последовательности: обработка фотографий
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 90
skinparam dpi 180

actor "Пользователь" as User
participant "Web client" as FE
participant "Routes Service" as Routes
database "PostgreSQL" as DB
queue "NATS JetStream" as NATS
participant "Photo Worker" as Worker
database "MinIO" as S3

== Пользовательский запрос ==

User -> FE : Загружает фотографию
activate FE
note right of FE
Frontend извлекает GPS
из EXIF, если он есть
end note

FE -> Routes : Сохраняет точку и фото
activate Routes
Routes -> DB : Сохраняет точку\nсо статусом pending
Routes -> NATS : Публикует photo.process
Routes --> FE : Точка создана
deactivate Routes

FE --> User : Показывает точку\nсо статусом "обработка"
deactivate FE

== Асинхронная обработка ==

NATS -> Worker : Получает photo task
activate Worker
Worker -> Worker : Декодирует изображение
Worker -> Worker : Строит resized original\nи thumbnail
Worker -> S3 : Загружает файлы
Worker -> DB : Обновляет URLs и статус = done
Worker -> NATS : Публикует photos.completed
deactivate Worker

== Уведомление клиента ==

NATS -> Routes : Событие photos.completed
Routes -> FE : WebSocket photo_processed
FE --> User : Обновляет фото у точки

@enduml
